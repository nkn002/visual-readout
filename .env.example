# Copy to .env. Paths are read by the backend (pydantic-settings) and by Compose.
DATA_DIR=./data/sample
DATABASE_URL=sqlite:///./data/db/app.db
CORS_ORIGINS=http://localhost:5173,https://nkn002.github.io
# Vite: base path on GitHub Pages ("/visual-readout/"); "/" for local dev
VITE_BASE=/
# Vite dev proxy target for /api (Compose sets http://backend:8000)
VITE_API_TARGET=http://localhost:8000
